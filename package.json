{
  "name": "dsh-alias",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "/alias add|remove|list for DeepSeek Harness: define your own slash commands, persisted in settings, with a configuration card on the Plugins page.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maci0/dsh-alias.git"
  },
  "icon": "./icon.svg",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
